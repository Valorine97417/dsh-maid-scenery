    "README.md",
    "LICENSE",
    "LICENSE-ARTWORK",
    "NOTICE",
    "LICENSE-upstream"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./skin.json": "./skin.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dsh": {
